{
  "name": "kotoba-chion",
  "productName": "Kotoba Chion",
  "version": "3.0.0",
  "description": "日中双语 / 纯日语 EPUB 阅读器 + 语言学习桌面应用",
  "author": "Chion240",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "fast-uri": "3.1.7"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "release:win": "node scripts/release-win.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "setup": "node node_modules/electron/install.js && electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "smoke": "node scripts/smoke.mjs",
    "test:storage": "node scripts/run-storage-selftest.mjs",
    "test:tokenizer": "node scripts/run-tokenizer-selftest.mjs",
    "setup:dict": "node scripts/fetch-sudachi-dict.mjs",
    "test:epub": "node scripts/run-epub-selftest.mjs",
    "test:reader": "node scripts/reader-selftest.mjs && node scripts/reader-scroll-selftest.mjs",
    "test:interaction": "node scripts/interaction-selftest.mjs",
    "test:library": "node scripts/library-selftest.mjs",
    "test:library-integ": "node scripts/run-library-integ.mjs",
    "test:progress": "node scripts/progress-selftest.mjs",
    "test:ai": "node scripts/ai-selftest.mjs",
    "test:ai-translation": "node scripts/ai-translation-selftest.mjs",
    "test:settings": "node scripts/settings-selftest.mjs",
    "test:settings-store": "node scripts/settings-store-selftest.mjs",
    "test:integration": "node scripts/integration-selftest.mjs",
    "test:tts": "node scripts/tts-selftest.mjs",
    "test:ipc": "node scripts/ipc-contract-selftest.mjs",
    "test:release": "node scripts/release-config-selftest.mjs",
    "seed:book": "node scripts/run-seed-book.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-slider": "1.4.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "better-sqlite3": "^11.8.1",
    "electron-store": "^10.0.0",
    "react-virtuoso": "4.14.0",
    "sudachi-wasm333": "1.0.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
